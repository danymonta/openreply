# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
# Generate with: openssl rand -hex 32  (NEVER keep this sample value)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# --- Self-hosted stack (compose.selfhost.yml) --------------------------------
# DATABASE_URL / REDIS_URL above are ignored there: compose builds them from
# these passwords. Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Production only: the public domain Caddy serves with HTTPS (NEXTAUTH_URL must
# then be https://<this domain>).
# OPENREPLY_DOMAIN=reply.example.com
# Local only: send magic links to the bundled Mailpit (http://localhost:8025)
# instead of Resend.
# EMAIL_SERVER=smtp://mailpit:1025

# Optional: max automated private replies per hour per Instagram account.
# Defaults to Meta's documented cap (750); a lower value leaves headroom.
# DM_RATE_LIMIT_PER_HOUR=300
# Optional: how many 30-minute retries a rate-limited DM gets before it is
# dropped (default 3). 48 = keep trying for 24 hours during a viral spike.
# DM_MAX_REQUEUE_ATTEMPTS=48

# Optional: "start" makes a plain DM trigger a campaign only when the message
# opens with a keyword (like "Message begins with" in other DM tools), so a word
# that comes up mid-conversation does not restart an automation. Story replies
# always match anywhere. Default: match anywhere.
# DM_TRIGGER_MATCH=start
